# CodeLens environment template - copy to .env and fill in
DATABASE_URL="postgresql://codelens:codelens@localhost:5432/codelens?schema=public"
REDIS_URL="redis://localhost:6379"

# GitHub OAuth App
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_WEBHOOK_SECRET=""

# App
APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
JWT_SECRET=""
ENCRYPTION_KEY=""

# AI - OpenAI compatible provider
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL=""

# Limits
MAX_REVIEW_FILES="50"
MAX_REVIEW_LINES="4000"
